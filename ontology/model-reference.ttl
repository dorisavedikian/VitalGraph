@prefix :       <https://www.ica.org/standards/RiC/ontology#> .
@prefix ncit:   <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix person: <https://w3id.org/MON/person.owl#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# Class hierarchy
:Agent            rdfs:subClassOf :Thing .
:Concept          rdfs:subClassOf :Thing .
:Date             rdfs:subClassOf :Thing .
:Event            rdfs:subClassOf :Thing .
:Place            rdfs:subClassOf :Thing .
:RecordResource   rdfs:subClassOf :Thing .
:Person           rdfs:subClassOf :Agent .
:Record           rdfs:subClassOf :RecordResource .
:Activity         rdfs:subClassOf :Event .
:Appellation      rdfs:subClassOf :Concept .
:Name             rdfs:subClassOf :Appellation .
:Type             rdfs:subClassOf :Concept .
:ActivityType     rdfs:subClassOf :Type .
:DemographicGroup rdfs:subClassOf :Type .
:EventType        rdfs:subClassOf :Type .
:OccupationType   rdfs:subClassOf :ActivityType, :DemographicGroup .

# Event types from NCIt
ncit:C25155 rdf:type :EventType . # Birth
ncit:C28554 rdf:type :EventType . # Death
ncit:C48033 rdf:type :EventType . # Marriage 

# Object property patterns
:DemographicGroup  :isOrWasDemographicGroupOf  :Person
:Event             :hasEventType               :EventType
:Event             :hasOrHadParticipant        :Person
:EventType         :isEventTypeOf              :Event
:OccupationType    :isOrWasOccupationTypeOf    :Person
:Person            :isOrWasParticipantIn       :Event
:Person            :hasChild                   :Person
:Person            :isChildOf                  :Person
:Person            :hasOrHadSpouse             :Person
:Person            :hasBirthDate               :Date
:Person            :hasDeathDate               :Date
:Person            :hasBirthPlace              :Place
:Person            :hasDeathPlace              :Place
:Person            :hasOrHadDemographicGroup   :DemographicGroup
:Person            :hasOrHadOccupationOfType   :OccupationType
:Place             :isBirthPlaceOf             :Person
:Place             :isDeathPlaceOf             :Person
:Record            :hasOrHadSubject            :Person
:Person            :isOrWasSubjectOf           :Record
:Activity          :documentedBy               :Record
:Record            :documents                  :Activity
:Name              :isOrWasNameOf              :Person
:Person            :hasOrHadName               :Name
:Person            person:hasGender            [person:Male OR person:Female]

# Datatype property patterns
:Record            :title                      rdfs:Literal
:Record            :identifier                 rdfs:Literal                         # Local or state file number
:Place             :name                       rdfs:Literal
:Place             rdfs:seeAlso                <URI>
:DemographicGroup  :name                       rdfs:Literal
:OccupationType    :name                       rdfs:Literal
:Name              :textualValue               rdfs:Literal
:Date              :expressedDate              rdfs:Literal
:Date              :normalizedDateValue        rdfs:Literal

# Datatype property patterns from the Person Ontology
:Person            person:firstName            xsd:string
:Person            person:lastName             xsd:string
:Person            person:maidenName           xsd:string

# Datatype property pattern from FOAF
:Person            foaf:age                    xsd:string
