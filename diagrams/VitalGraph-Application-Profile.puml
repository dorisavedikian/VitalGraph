@startuml
' VitalGraph application-profile view, transcribed from the supplied PDF.
' Association endpoints reflect VitalGraph usage, which can be narrower
' than an ontology property's full domain and range. No multiplicities inferred.
title VitalGraph Application Profile\nClasses and Relationships
left to right direction
hide empty members
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 70
skinparam ranksep 100
skinparam defaultFontName Arial
skinparam class {
  BackgroundColor #F6F3FA
  BorderColor #6D6279
  ArrowColor #625B6D
}

class "rico:RecordResource" as RecordResource
class "rico:Record" as Record #E3F0F4 {
  rico:title : rdfs:Literal
  rico:identifier : rdfs:Literal
}
class "rico:Event" as Event #FFF6CB
class "rico:Activity" as Activity #FFF6CB
class "rico:Agent" as Agent
class "rico:Person" as Person #ECE4F4 {
  person:firstName : xsd:string
  person:lastName : xsd:string
  person:maidenName : xsd:string
  foaf:age : xsd:string
}
class "rico:Concept" as Concept
class "rico:Appellation" as Appellation
class "rico:Name" as Name {
  rico:textualValue : rdfs:Literal
}
class "rico:Type" as Type
class "rico:EventType" as EventType
class "rico:ActivityType" as ActivityType
class "rico:DemographicGroup" as DemographicGroup {
  rico:name : rdfs:Literal
}
class "rico:OccupationType" as OccupationType {
  rico:name : rdfs:Literal
}
class "rico:Date" as Date #EEEBD7 {
  rico:expressedDate : rdfs:Literal
  rico:normalizedDateValue : rdfs:Literal
}
class "rico:Place" as Place {
  rico:name : rdfs:Literal
}
class "rdfs:Resource" as Resource <<external reference>>
class "person:Sex" as Sex <<external vocabulary>> {
  person:Male
  person:Female
}

RecordResource <|-- Record
Event <|-- Activity
Agent <|-- Person
Concept <|-- Appellation
Appellation <|-- Name
Concept <|-- Type
Type <|-- EventType
Type <|-- ActivityType
Type <|-- DemographicGroup
ActivityType <|-- OccupationType
DemographicGroup <|-- OccupationType

Record --> Activity : rico:documents\n(inverse: rico:documentedBy)
Record --> Person : rico:hasOrHadSubject\n(inverse: rico:isOrWasSubjectOf)
Event --> Person : rico:hasOrHadParticipant\n(inverse: rico:isOrWasParticipantIn)
Event --> EventType : rico:hasEventType\n(inverse: rico:isEventTypeOf)
Person --> Name : rico:hasOrHadName\n(inverse: rico:isOrWasNameOf)
Person --> Person : rico:isChildOf / rico:hasChild\nrico:hasOrHadSpouse
Person --> Date : rico:hasBirthDate\nrico:hasDeathDate
Person --> Place : rico:hasBirthPlace / rico:hasDeathPlace\n(inverse: rico:isBirthPlaceOf / rico:isDeathPlaceOf)
Person --> DemographicGroup : rico:hasOrHadDemographicGroup\n(inverse: rico:isOrWasDemographicGroupOf)
Person --> OccupationType : rico:hasOrHadOccupationOfType\n(inverse: rico:isOrWasOccupationTypeOf)
Person --> Sex : person:hasGender
Place --> Resource : rdfs:seeAlso

object "Birth\nncit:C25155" as Birth
object "Death\nncit:C28554" as Death
object "Marriage\nncit:C48033" as Marriage
Birth ..> EventType : rdf:type
Death ..> EventType : rdf:type
Marriage ..> EventType : rdf:type

legend bottom left
  Hollow triangle = subclass relationship
  Solid arrow = forward object-property direction
  Inverse properties run in the opposite direction
  Dashed arrow = rdf:type assertion for an event-type individual
  Class fields = recorded literal properties
  No cardinality constraints are asserted by this diagram.
endlegend
@enduml
